    "motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "recharts": "^2.15.1",
